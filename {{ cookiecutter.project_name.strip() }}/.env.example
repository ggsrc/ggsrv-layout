# Environment for local development. Copy this file to .env and adjust it.

# gglib: environment, logging and telemetry
ENV=local
LOG_LEVEL=debug
# Export traces and logs over OTLP/HTTP, for example to a local collector:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service settings ({{ cookiecutter.project_name.strip().replace("-", "_").upper() }}_*, see internal/config)
{{ cookiecutter.project_name.strip().replace("-", "_").upper() }}_MEMCACHEMAXTTLSECONDS=60

# PostgreSQL (POSTGRES_*, see github.com/stumble/wpgx)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=my-secret
POSTGRES_DBNAME={{ cookiecutter.project_name.strip() }}_test_db
POSTGRES_APPNAME={{ cookiecutter.project_name.strip() }}

# Redis (REDIS_*, see github.com/ggsrc/gglib/resource/cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Ports: gRPC, health probes (/health/ready, /health/alive), Prometheus metrics
GRPC_PORT=9090
HEALTHCHECK_PORT=8080
METRIC_PORT=4014
